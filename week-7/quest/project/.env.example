# Copy this file to .env and fill in your values
# Never commit the actual .env file

# PostgreSQL connection string (Supabase or any PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# HMAC-SHA256 password hashing secret — use a long random string in production
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET_KEY=change-me-to-a-random-secret

# Admin account email — this user can delete any course
ADMIN_EMAIL=admin@example.com

# Allowed CORS origin (your deployed URL). Use * for local dev only.
ORIGIN=https://your-app.vercel.app

# Server port (optional, defaults to 3000)
PORT=3000
